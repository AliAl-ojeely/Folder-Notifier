<Window x:Class="FolderNotifier.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Notes Manager" Height="600" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#FDFBF7"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="#F0EBE1" CornerRadius="4" Margin="0,2,2,2">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C4B7A6" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,20,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📝" FontSize="32" Margin="0,0,10,0"/>
                <TextBlock x:Name="AppTitleText" Text="My Folder Notes" FontSize="28" FontWeight="Bold" Foreground="#2A1B19" VerticalAlignment="Center"/>
                <Border Background="#EBE3D5" CornerRadius="12" Margin="15,0,0,0" Padding="10,2" VerticalAlignment="Center">
                    <TextBlock x:Name="NotesCountText" Text="0 Notes" FontSize="14" FontWeight="SemiBold" Foreground="#6E5C5A"/>
                </Border>
            </StackPanel>

            <Button x:Name="AboutBtn" Grid.Column="1" Content="❕" Width="30" Height="30" Margin="0,0,10,0" Background="#E0D5C1" Foreground="#2A1B19" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="AboutBtn_Click" ToolTip="Developer Info">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button x:Name="LangToggleBtn" Grid.Column="2" Content="AR" Width="40" Height="30" Background="#D1C7B7" Foreground="#2A1B19" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="LangToggleBtn_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="20,10,20,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderThickness="1" BorderBrush="#D1C7B7" Padding="10,5" Margin="0,0,15,0">
                <Grid>
                    <TextBlock x:Name="SearchPlaceholderText" Text="Search a Note ..." Foreground="#B5AFA6" FontSize="14" VerticalAlignment="Center" Margin="5,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" Margin="5,0,0,0"/>
                </Grid>
            </Border>

            <Button x:Name="RefreshBtn" Grid.Column="1" Content="🔄 Refresh" Width="100" Height="42" Margin="0,0,15,0" Background="#B8D8E3" BorderThickness="0" FontWeight="Bold" Foreground="#2A1B19" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="2" Width="170" Height="42" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="AddNote_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="➕" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="15"/>
                    <TextBlock x:Name="AddNoteBtnText" Text="Add Note" VerticalAlignment="Center" FontWeight="Bold" FontSize="15"/>
                </StackPanel>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#A84C40"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#8F3F35"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#A84C40"/>
                </Button.Effect>
            </Button>
        </Grid>

        <Grid Grid.Row="2" Background="#F4F0E6" Margin="20,0,20,10">
            <Border CornerRadius="8" Background="#FFFFFF" BorderThickness="1" BorderBrush="#E0D5C1">
                <Grid>
                    <ListView x:Name="NotesListView" Background="Transparent" BorderThickness="0" Margin="10" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="Padding" Value="15"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#E0D5C1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FCFAF5"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#F5EFE6"/>
                                                    <Setter Property="BorderBrush" Value="#C4B7A6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="ExtraBold" Foreground="#1A1A1A" TextTrimming="CharacterEllipsis"/>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="✏" FontSize="14" Background="Transparent" BorderThickness="0" Foreground="#7A5C5A" Cursor="Hand" Margin="0,0,10,0" ToolTip="Edit" Click="EditNote_Click"/>
                                            <Button Content="🗑" FontSize="14" Background="Transparent" BorderThickness="0" Foreground="#A84C40" Cursor="Hand" ToolTip="Delete" Click="DeleteNote_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="📁" FontSize="14" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding FolderPath}" FontSize="13" Foreground="#7A5C5A" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Separator Grid.Row="2" Background="#E0D5C1" Margin="0,0,0,10"/>

                                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat='Last Modified: {0:dd MMM yyyy}'}" FontSize="11" Foreground="#A39B8E" VerticalAlignment="Center"/>

                                        <Border Background="#E0D5C1" CornerRadius="4" Padding="5,1" Margin="10,0,0,0" Visibility="{Binding EditedVisibility}">
                                            <TextBlock Text="✏ Edited" FontSize="10" FontWeight="Bold" Foreground="#7A5C5A" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="📭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="EmptyTitleText" Text="No folder notes found." FontSize="18" FontWeight="SemiBold" Foreground="#A39B8E" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptySubText" Text="Click 'Add Note' to create your first note." FontSize="14" Foreground="#C4B7A6" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="3" Background="#EBE3D5" BorderThickness="0,1,0,0" BorderBrush="#D1C7B7">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <TextBlock x:Name="ReadyText" Text="Ready" FontWeight="Bold" Foreground="#6E5C5A" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusBarCountText" Text="0 Notes Loaded" Foreground="#8A7B76" Margin="0,0,10,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>