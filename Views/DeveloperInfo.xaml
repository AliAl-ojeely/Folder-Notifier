<Window x:Class="FolderNotifier.Views.DeveloperInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Developer Info" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType" FlowDirection="LeftToRight">

    <Window.Resources>
        <Style x:Key="HoverLinkStyle" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#A84C40"/>
            <Setter Property="TextDecorations" Value="None"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#8F3F35"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="15" Opacity="0.15" ShadowDepth="5" Color="Black"/>
        </Grid.Effect>

        <Border Background="#FDFBF7" CornerRadius="12" BorderBrush="#D1C7B7" BorderThickness="1">
            <StackPanel Margin="25">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="👨‍💻" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Developer Info" FontSize="20" FontWeight="Bold" Foreground="#2A1B19" VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Background="#E0D5C1" Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="Bold" Foreground="#6E5C5A" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Ali Al-ojeely (Frontend and Desktop Application Developer)" Foreground="#2A1B19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="App Version:" FontWeight="Bold" Foreground="#6E5C5A" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="1.2" Foreground="#2A1B19" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" FontWeight="Bold" Foreground="#6E5C5A" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                        <Hyperlink NavigateUri="mailto:alialojeely@gmail.com" RequestNavigate="Hyperlink_RequestNavigate" Style="{StaticResource HoverLinkStyle}">
                            <Run Text="alialojeely@gmail.com"/>
                        </Hyperlink>
                    </TextBlock>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="GitHub:" FontWeight="Bold" Foreground="#6E5C5A"/>
                    <TextBlock Grid.Row="3" Grid.Column="1">
                        <Hyperlink NavigateUri="https://github.com/AliAl-ojeely" RequestNavigate="Hyperlink_RequestNavigate" Style="{StaticResource HoverLinkStyle}">
                            <Run Text="https://github.com/AliAl-ojeely"/>
                        </Hyperlink>
                    </TextBlock>
                </Grid>

                <Button Content="Close" Width="120" Height="36" HorizontalAlignment="Center" Cursor="Hand" Click="CloseBtn_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#A84C40"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#8F3F35"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>