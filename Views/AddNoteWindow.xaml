<Window x:Class="FolderNotifier.Views.AddNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Note" Height="380" Width="450"
        WindowStartupLocation="CenterScreen" Background="#F4EFE6"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Added x:Name to support Arabic Language switching -->
        <TextBlock x:Name="AddNoteHeaderText" Text="Add Folder Note" FontSize="22" FontWeight="Bold" Foreground="#2A1B19" Margin="0,0,0,15"/>

        <!-- Added x:Name to support Arabic Language switching -->
        <TextBlock x:Name="PathLabelText" Grid.Row="1" Text="Selected Path:" FontWeight="Bold" Foreground="#4A2C2A" Margin="0,0,0,5"/>
        <TextBox x:Name="PathTextBox" Grid.Row="1" Margin="0,25,0,15" Height="30" IsReadOnly="True" 
                 Background="#E0D5C1" BorderBrush="#D1C7B7" Foreground="#4A2C2A" VerticalContentAlignment="Center" Padding="5,0"/>

        <!-- Added x:Name to support Arabic Language switching -->
        <TextBlock x:Name="TitleLabelText" Grid.Row="2" Text="Note Title:" FontWeight="Bold" Foreground="#4A2C2A" Margin="0,0,0,5"/>
        <TextBox x:Name="TitleTextBox" Grid.Row="2" Margin="0,25,0,15" Height="30" 
                 Background="#FFFFFF" BorderBrush="#D1C7B7" Foreground="#2A1B19" VerticalContentAlignment="Center" Padding="5,0"/>

        <!-- Added x:Name to support Arabic Language switching -->
        <TextBlock x:Name="ContentLabelText" Grid.Row="3" Text="Note Content:" FontWeight="Bold" Foreground="#4A2C2A" Margin="0,0,0,5"/>
        <TextBox x:Name="ContentTextBox" Grid.Row="3" Margin="0,25,0,15" AcceptsReturn="True" TextWrapping="Wrap" 
                 Background="#FFFFFF" BorderBrush="#D1C7B7" Foreground="#2A1B19" Padding="5"/>

        <!-- Buttons with style fixes -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">

            <!-- Cancel Button (Added x:Name) -->
            <Button x:Name="CancelBtn" Content="Cancel" Width="80" Height="35" Margin="0,0,10,0" Background="Transparent" Foreground="#4A2C2A" BorderThickness="0" Click="Cancel_Click" Cursor="Hand"/>

            <!-- Save Button (NOW FIXED WITH EXACT MAINWINDOW STYLES) -->
            <Button x:Name="SaveBtn" Width="100" Height="35" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" Click="Save_Click" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#A84C40"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#8F3F35"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#A84C40"/>
                </Button.Effect>
            </Button>

        </StackPanel>
    </Grid>
</Window>